#!/usr/bin/env bash
# Nightshift Kit — Commit message hook
# Validates ordinary spec commits and parent lifecycle transitions.
# Policy source of truth: .nightshift/GIT.md
#
# Ordinary format: [SPEC-ID] type: subject  (other accepted forms: see GIT.md Coordinator subjects)
# Lifecycle format: chore: mark SPEC-ID done|blocked (trailers) | in_progress (none)
# Examples:
#   [SPEC-033] feat: handler registry with pluggable domains
#   [SPEC-004-002] test: add NFR hierarchy tests
#   chore: mark SPEC-033 done
#   chore: mark SPEC-033 in_progress
#
# Install: cp .nightshift/hooks/commit-msg .git/hooks/commit-msg && chmod +x .git/hooks/commit-msg
# Disable: set git.commit_prefix: "none" in config.yaml

set -euo pipefail

COMMIT_MSG_FILE="$1"
FIRST_LINE=$(head -1 "$COMMIT_MSG_FILE")

# SPEC-416: the ID group below is spec_id.COMMIT_ID_ERE (SPEC|BUG|NFR|QUESTIONS kinds,
# legacy and project-prefixed shapes); test_spec_id.py pins this text to the parser.

# Allow merge commits and reverts without prefix
if echo "$FIRST_LINE" | grep -qE "^(Merge|Revert) "; then
    exit 0
fi

# SPEC-NS-KIT-118 R4: record_metrics reads lifecycle marks only in the exact `chore: mark <ID> ...`
# form, so a bracketed `[<ID>] chore: mark ...` commit (any status, trailers or not) would pass
# this hook and then be silently skipped by metrics. Reject it before any other rule.
if echo "$FIRST_LINE" | grep -qE '^\[(SPEC|BUG|NFR|QUESTIONS)-([A-Z0-9]+-)*[0-9]+\] chore: mark '; then
    echo ""
    echo "[nightshift commit-msg] ERROR: bracketed lifecycle subject is not accepted; use \`chore: mark <ID> done|blocked|in_progress\`"
    echo ""
    echo "  Got:      $FIRST_LINE"
    echo ""
    exit 1
fi

# Terminal lifecycle commits are emitted by the parent and consumed by
# record_metrics.py.  The evidence contract is author-independent: a worker
# cannot bypass it by writing a canonical lifecycle subject itself.
if echo "$FIRST_LINE" | grep -qE '^chore: mark (SPEC|BUG|NFR|QUESTIONS)-([A-Z0-9]+-)*[0-9]+ (done|blocked)$'; then
    SPEC_ID=$(printf '%s\n' "$FIRST_LINE" | sed -nE 's/^chore: mark ((SPEC|BUG|NFR|QUESTIONS)-([A-Z0-9]+-)*[0-9]+) (done|blocked)$/\1/p')
    TERMINAL=$(printf '%s\n' "$FIRST_LINE" | sed -nE 's/^chore: mark ((SPEC|BUG|NFR|QUESTIONS)-([A-Z0-9]+-)*[0-9]+) (done|blocked)$/\4/p')
    REQUIRED_LIFECYCLE_TRAILERS=(
        "Nightshift-Evidence-Report"
        "Nightshift-Evidence-Tests"
        "Nightshift-Evidence-Code"
        "Nightshift-Evidence-ACs"
        "Nightshift-Evidence-Verifier"
        "Nightshift-Blocker-Class"
        "Nightshift-Blocker-Scope"
        "Nightshift-Unblock-Attempts"
        "Nightshift-Unblock-Limit"
        "Nightshift-Parent-Tool-Calls"
        "Nightshift-Resolution-Kind"
    )
    missing=()
    for trailer in "${REQUIRED_LIFECYCLE_TRAILERS[@]}"; do
        if ! grep -qE "^${trailer}:[[:space:]]*[^[:space:]]" "$COMMIT_MSG_FILE"; then
            missing+=("$trailer")
        fi
    done
    if [ "${#missing[@]}" -gt 0 ]; then
        echo "[nightshift commit-msg] ERROR: terminal lifecycle commit is missing required trailer(s): ${missing[*]}" >&2
        exit 1
    fi
    # SPEC-224 terminal-outcome-record: projects explicitly opting into terminal_outcomes receive a
    # second boundary. The Python module reads the configured adapter and staged
    # data, so this shell hook never duplicates a record parser. A deliberate
    # `git commit --no-verify` remains outside hook enforcement by Git design.
    if [ -f ".nightshift/terminal_outcomes.py" ] && [ -f ".nightshift/config.yaml" ] && command -v python3 >/dev/null 2>&1; then
        python3 .nightshift/terminal_outcomes.py --check-staged --repo . \
            --config .nightshift/config.yaml --spec-id "$SPEC_ID" --terminal "$TERMINAL"
    fi
    exit 0
fi

# BUG-NS-KIT-106 / SPEC-NS-KIT-118: the non-terminal status marks (in_progress, draft, planned, ready,
# superseded, retired) the run guide (Step 2b/2c) commits and
# record_metrics.find_in_progress_sha reads. Anchored, so it cannot match done|blocked and
# carries no terminal trailer requirement.
if echo "$FIRST_LINE" | grep -qE '^chore: mark (SPEC|BUG|NFR|QUESTIONS)-([A-Z0-9]+-)*[0-9]+ (draft|planned|ready|in_progress|superseded|retired)$'; then
    exit 0
fi

# SPEC-183: documentation-only commits under configured prefixes may use a conventional
# subject without a spec ID. A knowledge corpus has no specs, so requiring one forces
# either a fabricated ID or --no-verify (which also skips the secret scan). In one repo
# this left an entire vault untracked for months. Opt-in and empty by default:
#
#   git:
#     unprefixed_paths:
#       - "Wiedza/"
#
# The exemption applies only when EVERY staged path is under one of those prefixes.
# The allowlist is read by scanner.py so the kit keeps ONE config reader. A separate
# hand-rolled parser here swallowed an inline comment and produced a garbage prefix.
# Fails open (spec prefix still required) if python3 or scanner.py is unavailable.
CONFIG_FILE=".nightshift/config.yaml"
SCANNER=".nightshift/scanner.py"
if [ -f "$CONFIG_FILE" ] && [ -f "$SCANNER" ] && command -v python3 >/dev/null 2>&1; then
    UNPREFIXED=$(python3 "$SCANNER" --unprefixed-paths --config "$CONFIG_FILE" 2>/dev/null || true)

    if [ -n "$UNPREFIXED" ]; then
        STAGED=$(git diff --cached --name-only 2>/dev/null || true)
        if [ -n "$STAGED" ]; then
            ALL_UNDER=1
            while IFS= read -r staged_path; do
                [ -z "$staged_path" ] && continue
                MATCHED=0
                while IFS= read -r prefix; do
                    [ -z "$prefix" ] && continue
                    case "$staged_path" in
                        "$prefix"*) MATCHED=1; break ;;
                    esac
                done <<< "$UNPREFIXED"
                if [ "$MATCHED" -eq 0 ]; then
                    ALL_UNDER=0
                    break
                fi
            done <<< "$STAGED"

            # Conventional-commit subject: type(optional scope): description
            if [ "$ALL_UNDER" -eq 1 ] && \
               echo "$FIRST_LINE" | grep -qE '^(feat|fix|docs|chore|refactor|test|style|perf|build|ci)(\([^)]+\))?!?: .+'; then
                exit 0
            fi
        fi
    fi
fi

# SPEC-NS-KIT-118: the remaining subjects, in order.
# B. A `chore: mark ` or `chore(scope): mark ` subject that is not an exact lifecycle form (done|blocked|in_progress
#    with a valid ID, handled above) is a malformed lifecycle subject. Never let the
#    maintenance rule (C) absorb it.
if echo "$FIRST_LINE" | grep -qE '^chore(\([^)]*\))?!?: mark '; then
    echo ""
    echo "[nightshift commit-msg] ERROR: malformed lifecycle subject."
    echo ""
    echo "  Got:      $FIRST_LINE"
    echo "  Expected: chore: mark <ID> done|blocked|in_progress   (<ID> like SPEC-123, BUG-NS-KIT-45)"
    echo "            done|blocked also need the Nightshift-* lifecycle trailers."
    echo ""
    exit 1
fi

# Ordinary commits: spec prefix, separator, and non-empty subject.
if echo "$FIRST_LINE" | grep -qE '^\[(SPEC|BUG|NFR|QUESTIONS)-([A-Z0-9]+-)*[0-9]+\] .+'; then
    exit 0
fi

# E. `<ID>: description`
if echo "$FIRST_LINE" | grep -qE '^(SPEC|BUG|NFR|QUESTIONS)-([A-Z0-9]+-)*[0-9]+: .+'; then
    exit 0
fi

# C. Maintenance subjects need no ID.
if echo "$FIRST_LINE" | grep -qE '^(chore|telemetry|release|merge): .+'; then
    exit 0
fi

# D. Conventional subjects are accepted only when the subject line carries an ID
#    (in the scope or the text, unanchored).
if echo "$FIRST_LINE" | grep -qE '^(feat|fix|docs|test|refactor|perf|build|ci|style|chore|spec|evidence|audit|draft|formal|research|wip)(\([^)]*\))?!?: .+' && \
   echo "$FIRST_LINE" | grep -qE '(SPEC|BUG|NFR|QUESTIONS)-([A-Z0-9]+-)*[0-9]+'; then
    exit 0
fi

echo ""
echo "[nightshift commit-msg] ERROR: Commit message must use a Nightshift subject."
echo ""
echo "  Got:      $FIRST_LINE"
echo "  Accepted forms:"
echo "    [<ID>] type: description               (ordinary; ID kinds: SPEC, BUG, NFR, QUESTIONS)"
echo "    <ID>: description"
echo "    chore: mark <ID> done|blocked|in_progress|draft|planned|ready|superseded|retired   (done|blocked need lifecycle trailers)"
echo "    chore|telemetry|release|merge: description  (maintenance, no ID needed)"
echo "    type(scope): description                    (type: feat fix docs test refactor perf build ci chore"
echo "                                                 style spec evidence audit draft formal research wip;"
echo "                                                 the subject must contain an <ID>)"
echo "    Merge ... / Revert ..                       (git-generated)"
echo ""
echo "  This ensures every commit is traceable to its spec."
echo "  To bypass (not recommended): git commit --no-verify"
echo ""
exit 1
